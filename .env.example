# --- データ保存先（Upstash Redis / Vercel Marketplace） ---
# Vercelでストレージを接続すると自動で設定されます（KV_REST_API_* でも可）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- アクセス制限（任意・推奨）: 両方設定するとサイト全体にBasic認証がかかります ---
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# --- 管理者ログイン（任意・推奨）: 設定すると「各種マスタ設定」タブが管理者ログイン必須になります ---
ADMIN_PASSWORD=

# --- プッシュ通知（任意）: `node scripts/gen-vapid.mjs` で作った鍵を設定すると、スマホ・パソコンへの通知が使えます ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 連絡先（任意）: mailto:あなたのメールアドレス
VAPID_SUBJECT=
# 毎朝の自動通知（vercel.json の crons）に必要。推測されにくい長い文字列にしてください
CRON_SECRET=

# 現場管理アプリから開いたとき、運転者のログインを引き継ぐための共通の鍵（現場管理アプリと同じ値。16文字以上）
SSO_SECRET=
